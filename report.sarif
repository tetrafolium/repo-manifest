{
  "version": "2.1.0",
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Coverity"
        }
      },
      "results": [
        {
          "ruleId": "FORWARD_NULL",
          "level": "warning",
          "message": {
            "text": "Calling a method on null object \"s\"."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ant/src/oata/HelloWorld.java"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 6
                }
              }
            }
          ]
        },
        {
          "ruleId": "USELESS_CALL",
          "level": "warning",
          "message": {
            "text": "Calling \"s.length()\" is only useful for its return value, which is ignored."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ant/src/oata/HelloWorld.java"
                },
                "region": {
                  "startLine": 6,
                  "endLine": 6
                }
              }
            }
          ]
        },
        {
          "ruleId": "FORWARD_NULL",
          "level": "warning",
          "message": {
            "text": "Calling a method on null object \"value\"."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sources/meta-openembedded/src/oata/HelloWorld.java"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 9
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
