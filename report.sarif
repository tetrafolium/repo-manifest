{
  "version": "2.1.0",
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "MetadataTestTool"
        }
      },
      "results": [
        {
          "ruleId": "META-001",
          "level": "warning",
          "rank": 30,
          "message": {
            "text": "Test warning issue with labels and notes"
          },
          "properties": {
            "labels": ["duplicate", "deferred"],
            "notes": {"review_status": "pending", "category": "metadata-test"}
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sources/meta-openembedded/README"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "META-002",
          "level": "error",
          "rank": 70,
          "message": {
            "text": "Test error issue with false positive label"
          },
          "properties": {
            "labels": ["false positive", "flaky"]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sources/meta-openembedded/README"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 5
                }
              }
            }
          ]
        },
        {
          "ruleId": "META-003",
          "level": "note",
          "rank": 5,
          "message": {
            "text": "Test info issue - severity should stay as info"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sources/meta-openembedded/README"
                },
                "region": {
                  "startLine": 10,
                  "endLine": 10
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
